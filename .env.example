# DareFX Configuration

# Telegram Bot (for trade notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# MetaTrader 5 Direct Broker Settings
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Valetax-Demo
MT5_SIMULATION=false

# MetaApi Cloud MT5 Bridge (recommended for Linux / Pterodactyl / Docker)
# Sign up at https://app.metaapi.cloud to connect your Valetax MT5 account
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID=your_metaapi_account_id_here

# Risk Management
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_TOTAL_DRAWDOWN_PCT=15.0

# Model
MODEL_PATH=data/models/latest.lgb
LOOKBACK_DAYS=252
